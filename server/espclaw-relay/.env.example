# Copy to .env on the SERVER only. Empty credentials deliberately prevent startup.
RELAY_DOMAIN=relay.example.com
CLOUD_API_KEY=
DEVICE_TOKENS_JSON={}
CLOUD_HTTP_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_REALTIME_URL=wss://ws-YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
TEXT_MODELS=qwen-plus
REALTIME_MODELS=qwen3.5-omni-flash-realtime
MAX_HTTP_REQUESTS=16
MAX_REALTIME_SESSIONS=16
HTTP_PER_DEVICE=2
REQUESTS_PER_MINUTE=60
HTTP_TIMEOUT_SECONDS=120
REALTIME_SESSION_SECONDS=900
# Production: use the shared factory key registry; no static device tokens.
DEVICE_REGISTRY_URL=http://127.0.0.1:3000/internal/device-keys
